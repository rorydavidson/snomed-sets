# Copy to .env and fill in. The .env file is ignored by git; never commit real values.

# Database (created on first start)
DB_NAME=valuesets
DB_USER=valuesets
DB_PASSWORD=

# Keycloak. The issuer must be reachable under the same address from your browser
# and from inside the api container.
KEYCLOAK_ISSUER_URI=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Snowstorm. The public server refuses server-side calls, so point this at your own instance:
#   http://host.docker.internal:8080  a Snowstorm already running on this machine
#   http://snowstorm:8080             the one started by the local-snowstorm profile
SNOWSTORM_BASE_URL=http://host.docker.internal:8080

# Port the application is served on
WEB_PORT=8090

# The sign-in cookie is sent over HTTPS only. Browsers make an exception for http://localhost.
# Set to false only if you open the application over plain HTTP from another machine.
SESSION_COOKIE_SECURE=true

# Only for docker-compose.proxy.yml: the Docker network of a reverse proxy such as Nginx Proxy Manager
PROXY_NETWORK=

# Development only: sign in with one local user instead of Keycloak.
# Used only when SPRING_PROFILES_ACTIVE includes "local-login"; the Keycloak settings are then ignored.
# Choose your own values. Never switch this on for a shared or deployed environment.
LOCAL_LOGIN_USERNAME=
LOCAL_LOGIN_PASSWORD=

# "default" starts with an empty library. On your own machine, "dev" also loads sample value
# sets that nobody can delete, and "dev,local-login" signs in with the local user above
# instead of Keycloak. Never use either on a server.
SPRING_PROFILES_ACTIVE=default
