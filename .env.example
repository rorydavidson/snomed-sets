# Copy to .env and fill in. The .env file is ignored by git; never commit real values.

# Database (created on first start)
DB_NAME=valuesets
DB_USER=valuesets
DB_PASSWORD=

# Keycloak. The issuer must be reachable under the same address from your browser
# and from inside the api container.
KEYCLOAK_ISSUER_URI=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Snowstorm. Leave unset for the public server, or point at your own instance,
# for example http://snowstorm:8080 when using the local-snowstorm profile.
# SNOWSTORM_BASE_URL=

# Port the application is served on
WEB_PORT=8080

# "dev" loads sample value sets. Set to "default" to start with an empty library.
SPRING_PROFILES_ACTIVE=dev
